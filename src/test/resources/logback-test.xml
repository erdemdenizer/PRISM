<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests log to the console only. Logback prefers this file to logback.xml, so a test run never
  writes into the per-user log folder of the person running it.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
